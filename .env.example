# Application Configuration
NODE_ENV=production
APP_PORT=3000
LOG_LEVEL=info

# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app_db

# Redis Configuration
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=redis-password

# pgAdmin Configuration (Development only)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# Application Settings
API_TIMEOUT=30000
MAX_CONNECTIONS=100

# Logging
LOG_FORMAT=json
LOG_LEVEL=debug
